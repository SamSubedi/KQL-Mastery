SigninLogs
| where ResultType == 0
| project UserPrincipalName, Location, TimeGenerated
| join kind=inner (
    SigninLogs
    | where ResultType == 0
    | project UserPrincipalName, Location, TimeGenerated
) on UserPrincipalName
| where abs(datetime_diff('minute', TimeGenerated, TimeGenerated1)) < 60
| where Location != Location1
